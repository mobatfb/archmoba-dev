{
  "manifest_version": 3,
  "name": "FUTUREO Gamepad Bridge",
  "version": "1.0.0",
  "description": "Permite que juegos web autorizados lean los mandos FUTUREO_VJOY mediante Gamepad API y un puente local de Windows.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:38471/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FUTUREO Gamepad Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "page-shim.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
