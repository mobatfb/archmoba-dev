<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Rutas NuGet oficiales WDK/SDK, como en microsoft/Windows-driver-samples.
       Este archivo solo afecta al proyecto FUTUREO_VJOY. -->
  <PropertyGroup>
    <FutureoPackagesRoot>$(MSBuildThisFileDirectory)..\..\packages\</FutureoPackagesRoot>
  </PropertyGroup>
  <Import Project="$(FutureoPackagesRoot)Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('$(FutureoPackagesRoot)Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(FutureoPackagesRoot)Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('$(FutureoPackagesRoot)Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(FutureoPackagesRoot)Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('$(FutureoPackagesRoot)Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props')" />
</Project>
