<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MingaTV" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- Android 12+ recorta los iconos del splash nativo a una mascara.
         Lo mantenemos negro y sin logo; SplashActivity muestra el logo completo. -->
    <style name="Theme.MingaTV.Splash" parent="Theme.MingaTV">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
    </style>
</resources>
